# Clés d'API — copier vers .env et renseigner. Ne jamais committer .env.

# https://www.opendota.com/api-keys (optionnel : 50 000 appels/mois sans clé)
OPENDOTA_API_KEY=

# https://cs.balldontlie.io/
BALLDONTLIE_API_KEY=

# Accès accordé sur demande : https://liquipedia.net/api-terms-of-use
LIQUIPEDIA_API_KEY=
# User-Agent identifiant, avec contact — exigé par les conditions d'utilisation
LIQUIPEDIA_USER_AGENT=
